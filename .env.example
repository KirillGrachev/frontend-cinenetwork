# --- Backend integration -------------------------------------------------
# Set to 'true' to fetch data from the real REST API instead of mock
# providers. Default (unset/false) = mock data, app runs fully offline.
VITE_API_ENABLED=false

# Base URL of the backend (no trailing slash).
# Example: VITE_API_BASE_URL=https://api.cinenetwork.example
VITE_API_BASE_URL=
